# ==============================================================================
# UTeM Ride - Monorepo .gitignore
# ==============================================================================

# ─── Dependencies ───
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Environment Variables (CRITICAL) ───
.env
.env.*
!.env.example
.env.local
backend/.env

# ─── React Native / Expo ───
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/ios
/android
.kotlin/

# ─── Backend (NestJS & Prisma) ───
backend/dist/
backend/generated/
.nestjs/
backend/.nestjs/
prisma/*.db
prisma/*.db-journal
backend/prisma/*.db
backend/prisma/*.db-journal

# ─── Docker ───
postgres_data/

# ─── Build, Testing & TypeScript ───
*.tsbuildinfo
build/
coverage/
.nyc_output/

# ─── OS & Editor Files ───
.DS_Store
*.DS_Store
.vscode/
.idea/
*.pem
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
